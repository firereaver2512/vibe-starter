import React, { useState, useEffect } from 'react';
import { 
  INITIAL_GRANTS, 
  INITIAL_DELIVERABLES, 
  INITIAL_SGX_METRICS, 
  CANVAS_STICKY_NOTES,
  DEFAULT_DEMO_USERS 
} from './data/mockData';
import { Grant, Deliverable, SgxMetric, CanvasStickyNote, User, SubscriptionTier } from './types';
import { Header } from './components/Header';
import { Hero } from './components/Hero';
import { InteractiveWorkspace } from './components/InteractiveWorkspace';
import { ValuePropsBento } from './components/ValuePropsBento';
import { SubscriptionTiers } from './components/SubscriptionTiers';
import { SecurityArchitecture } from './components/SecurityArchitecture';
import { EcosystemChannels } from './components/EcosystemChannels';
import { OnboardingModal } from './components/OnboardingModal';
import { AuthModal } from './components/AuthModal';
import { SubscriptionModal } from './components/SubscriptionModal';
import { Footer } from './components/Footer';
import { CheckCircle2, ShieldCheck } from 'lucide-react';

export default function App() {
  const [currentUser, setCurrentUser] = useState<User | null>(() => {
    try {
      const saved = localStorage.getItem('verigrant_user');
      return saved ? JSON.parse(saved) : DEFAULT_DEMO_USERS[0];
    } catch {
      return DEFAULT_DEMO_USERS[0];
    }
  });
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [authMode, setAuthMode] = useState<'signin' | 'signup'>('signin');
  const [authToast, setAuthToast] = useState<string | null>(null);

  const [grants, setGrants] = useState<Grant[]>(INITIAL_GRANTS);
  const [deliverables, setDeliverables] = useState<Deliverable[]>(INITIAL_DELIVERABLES);
  const [metrics, setMetrics] = useState<SgxMetric[]>(INITIAL_SGX_METRICS);
  const [canvasNotes, setCanvasNotes] = useState<CanvasStickyNote[]>(CANVAS_STICKY_NOTES);
  const [isOnboardingOpen, setIsOnboardingOpen] = useState(false);
  const [activeWorkspaceTab, setActiveWorkspaceTab] = useState<string>('ledger');

  const [selectedTierForModal, setSelectedTierForModal] = useState<SubscriptionTier | null>(null);
  const [selectedIntervalForModal, setSelectedIntervalForModal] = useState<'monthly' | 'annual'>('annual');
  const [isSubscriptionModalOpen, setIsSubscriptionModalOpen] = useState(false);

  const handleOpenAuth = (mode: 'signin' | 'signup' = 'signin') => {
    setAuthMode(mode);
    setIsAuthOpen(true);
  };

  const handleLoginSuccess = (user: User) => {
    setCurrentUser(user);
    try {
      localStorage.setItem('verigrant_user', JSON.stringify(user));
    } catch {
      // ignore storage errors
    }
    setAuthToast(`Authenticated as ${user.name} (${user.company})`);
    setTimeout(() => {
      setAuthToast(null);
    }, 4000);
  };

  const handleSignOut = () => {
    setCurrentUser(null);
    try {
      localStorage.removeItem('verigrant_user');
    } catch {
      // ignore
    }
    setAuthToast('Signed out of VeriGrant. Running in Sandbox terminal mode.');
    setTimeout(() => {
      setAuthToast(null);
    }, 4000);
  };

  const handleSelectTier = (tier: SubscriptionTier, interval: 'monthly' | 'annual') => {
    setSelectedTierForModal(tier);
    setSelectedIntervalForModal(interval);
    setIsSubscriptionModalOpen(true);
  };

  const handleConfirmSubscription = (tierId: SubscriptionTier['id'], interval: 'monthly' | 'annual') => {
    if (currentUser) {
      const clearanceText =
        tierId === 'enterprise'
          ? 'Tier-1 SGX Mainboard Issuer · Institutional Enterprise SLA'
          : tierId === 'professional'
          ? 'Tier-2 SGX Catalist Issuer · Full Core 27 Automation'
          : 'Tier-3 Innovator Recipient · Standard Claim Clearance';

      const updatedUser: User = {
        ...currentUser,
        subscription: {
          tierId,
          billingInterval: interval,
          status: 'active',
          renewsOn: interval === 'annual' ? '2027-11-12' : '2026-12-12',
          invoiceReference: `INV-${tierId.toUpperCase().slice(0, 3)}-${Date.now().toString().slice(-4)}`,
        },
        tierClearance: clearanceText,
      };

      setCurrentUser(updatedUser);
      try {
        localStorage.setItem('verigrant_user', JSON.stringify(updatedUser));
      } catch {
        // ignore
      }

      setAuthToast(`Upgraded to VeriGrant ${tierId.toUpperCase()} (${interval} plan).`);
      setTimeout(() => {
        setAuthToast(null);
      }, 4500);
    } else {
      setAuthToast(`Plan ${tierId.toUpperCase()} selected. Please sign in to activate your corporate terminal.`);
      setTimeout(() => {
        setAuthToast(null);
      }, 4500);
    }
  };

  const handleUpdateDeliverableStatus = (
    id: string, 
    status: Deliverable['status'], 
    triggered: boolean = false
  ) => {
    setDeliverables((prev) =>
      prev.map((d) => {
        if (d.id === id) {
          const updated = {
            ...d,
            status,
            disbursementTriggered: triggered || d.disbursementTriggered,
            completionPercentage: status === 'Verified & Approved' ? 100 : d.completionPercentage,
          };
          return updated;
        }
        return d;
      })
    );

    // If verified & approved with disbursement, reflect in grant balances
    if (status === 'Verified & Approved') {
      const del = deliverables.find((d) => d.id === id);
      if (del) {
        setGrants((prevGrants) =>
          prevGrants.map((g) => {
            if (g.id === del.grantId) {
              const newDisbursed = g.disbursedAmount + del.budgetAllocated;
              const newPending = Math.max(0, g.pendingClaimAmount - del.budgetAllocated);
              return {
                ...g,
                disbursedAmount: newDisbursed,
                pendingClaimAmount: newPending,
                completedDeliverablesCount: Math.min(
                  g.deliverablesCount,
                  g.completedDeliverablesCount + 1
                ),
              };
            }
            return g;
          })
        );
      }
    }
  };

  const handleAddDeliverable = (newDel: Omit<Deliverable, 'id'>) => {
    const created: Deliverable = {
      ...newDel,
      id: `del-${Date.now()}`,
    };
    setDeliverables((prev) => [created, ...prev]);

    // Update grant count
    setGrants((prev) =>
      prev.map((g) => {
        if (g.id === newDel.grantId) {
          return {
            ...g,
            deliverablesCount: g.deliverablesCount + 1,
            pendingClaimAmount: g.pendingClaimAmount + newDel.budgetAllocated,
          };
        }
        return g;
      })
    );
  };

  const handleAddCanvasNote = (note: CanvasStickyNote) => {
    setCanvasNotes((prev) => [note, ...prev]);
  };

  const handleOpenWorkspace = (tab?: string) => {
    if (tab) {
      setActiveWorkspaceTab(tab);
    }
    const element = document.getElementById('workspace');
    if (element) {
      element.scrollIntoView({ behavior: 'smooth' });
    }
  };

  const handleExploreDemo = () => {
    handleOpenWorkspace('ledger');
  };

  const handleViewCanvas = () => {
    handleOpenWorkspace('canvas');
  };

  return (
    <div className="min-h-screen flex flex-col bg-slate-50 text-slate-900 relative">
      {/* Auth Notification Toast */}
      {authToast && (
        <div className="fixed bottom-6 right-6 z-50 animate-in fade-in slide-in-from-bottom-4 duration-300">
          <div className="bg-slate-900 text-white text-xs px-4 py-3 rounded-2xl shadow-xl border border-slate-800 flex items-center gap-3">
            <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
            <span className="font-medium">{authToast}</span>
            <button
              onClick={() => setAuthToast(null)}
              className="text-slate-400 hover:text-white text-sm font-bold ml-1 cursor-pointer"
            >
              ×
            </button>
          </div>
        </div>
      )}

      {/* 1. Header (Top Bar: Brand, Navigation, Auth status, Sandbox CTA) */}
      <Header
        currentUser={currentUser}
        onOpenWorkspace={handleOpenWorkspace}
        onOpenOnboarding={() => setIsOnboardingOpen(true)}
        onOpenAuth={handleOpenAuth}
        onSignOut={handleSignOut}
      />

      {/* 2. Hero Section */}
      <main className="flex-1">
        <Hero
          currentUser={currentUser}
          onExploreDemo={handleExploreDemo}
          onViewCanvas={handleViewCanvas}
          onOpenAuth={handleOpenAuth}
        />

        {/* 3. The Interactive Live Workspace */}
        <InteractiveWorkspace
          key={activeWorkspaceTab}
          initialTab={activeWorkspaceTab}
          currentUser={currentUser}
          grants={grants}
          deliverables={deliverables}
          metrics={metrics}
          canvasNotes={canvasNotes}
          onOpenAuth={handleOpenAuth}
          onUpdateDeliverableStatus={handleUpdateDeliverableStatus}
          onAddDeliverable={handleAddDeliverable}
          onAddCanvasNote={handleAddCanvasNote}
        />

        {/* 4. Value Propositions Bento Grid (8 sticky notes from image) */}
        <ValuePropsBento />

        {/* 5. Enterprise Subscription Tiers */}
        <SubscriptionTiers
          currentUser={currentUser}
          onSelectTier={handleSelectTier}
          onOpenOnboarding={() => setIsOnboardingOpen(true)}
        />

        {/* 6. Key Activities & Resources: Security & Cloud Infrastructure */}
        <SecurityArchitecture />

        {/* 7. Channels, Ecosystem & Customer Relationships */}
        <EcosystemChannels
          onOpenOnboarding={() => setIsOnboardingOpen(true)}
          onOpenAssistant={() => handleOpenWorkspace('assistant')}
        />
      </main>

      {/* 8. Quiet Professional Footer */}
      <Footer
        onOpenWorkspace={handleOpenWorkspace}
        onOpenOnboarding={() => setIsOnboardingOpen(true)}
        onOpenAuth={handleOpenAuth}
      />

      {/* 9. Onboarding Consultation Modal */}
      <OnboardingModal
        isOpen={isOnboardingOpen}
        onClose={() => setIsOnboardingOpen(false)}
      />

      {/* 10. Sign In / Create Account Modal */}
      <AuthModal
        isOpen={isAuthOpen}
        initialMode={authMode}
        onClose={() => setIsAuthOpen(false)}
        onLoginSuccess={handleLoginSuccess}
      />

      {/* 11. Subscription & Plan Upgrade Modal */}
      <SubscriptionModal
        isOpen={isSubscriptionModalOpen}
        tier={selectedTierForModal}
        billingInterval={selectedIntervalForModal}
        currentUser={currentUser}
        onClose={() => setIsSubscriptionModalOpen(false)}
        onConfirmSubscription={handleConfirmSubscription}
        onOpenAuth={handleOpenAuth}
      />
    </div>
  );
}
